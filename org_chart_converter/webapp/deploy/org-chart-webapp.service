[Unit]
Description=Org Chart Wireframe web app
After=network.target

[Service]
Type=simple
User=orgchart
Group=orgchart
WorkingDirectory=/opt/org-chart-webapp/webapp
Environment=PATH=/opt/org-chart-webapp/venv/bin
ExecStart=/opt/org-chart-webapp/venv/bin/gunicorn -w 4 -b 127.0.0.1:8000 app:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
